# Telegram bridge configuration.
# Copy to .env and fill in. Never commit .env.

# From @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=

# Your Telegram user id (message @userinfobot). Comma-separated list allowed.
# The bridge ignores every chat that is not listed here. Required.
TELEGRAM_CHAT_ID=

# Where the OpenMuse API is running.
OPENMUSE_API_URL=http://127.0.0.1:8787

# Only needed when OpenMuse runs with WORKSPACE_MODE=live.
OPENMUSE_ACCESS_KEY=

# Optional: pin every Telegram message to one OpenMuse thread id.
# Leave unset to use the account's main thread (and /new to start a fresh one).
# BRIDGE_THREAD_ID=

# How long to wait for the agent's reply before giving up (milliseconds).
REPLY_TIMEOUT_MS=180000

# How often to check the thread for a reply (milliseconds).
POLL_INTERVAL_MS=2000

# Messages sent back to Telegram are split at this length.
TELEGRAM_CHUNK_SIZE=3500
